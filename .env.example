# Токен від @BotFather
BOT_TOKEN=123456789:AAAA-your-token

# Твій Telegram ID (бот покаже його на /start, якщо тут ще не той ID)
ADMIN_TELEGRAM_ID=0

# Секрет між ботом і API. Згенерувати: openssl rand -hex 32
API_KEY=change-me

# PostgreSQL. Пароль краще без спецсимволів: openssl rand -hex 16
POSTGRES_USER=note
POSTGRES_PASSWORD=change-me
POSTGRES_DB=note
